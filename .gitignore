# ==============================================================================
# .gitignore — Исключаем чувствительные файлы из git-репозитория
# ==============================================================================

# ── Сохранённые учётные данные VPS (IP, логин, пароль) ───────────────────────
.vpn-config

# ── Скачанные клиентские конфиги (содержат приватные ключи) ──────────────────
*.conf

# ── QR-коды (содержат конфиг с приватным ключом) ─────────────────────────────
*.png

# ── Директория с ключами (если когда-либо окажется локально) ─────────────────
keys/

# ── Прочие чувствительные файлы ──────────────────────────────────────────────
*.key
*.pem
*.p12
server.env

# ── macOS мусор ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*

# ── Редакторы ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
